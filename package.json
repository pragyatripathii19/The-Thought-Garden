{
  "name": "thought-garden",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "cd frontend && npm install --include=dev && npm run build",
    "start": "node --env-file-if-exists=.env backend/server.cjs",
    "dev:backend": "node --env-file-if-exists=.env backend/server.cjs",
    "dev:frontend": "cd frontend && npm run dev",
    "reset-password": "node --env-file-if-exists=.env backend/scripts/reset-password.cjs",
    "test": "cd frontend && npm test",
    "test:backend": "node --env-file-if-exists=.env backend/test-backend.cjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  }
}
