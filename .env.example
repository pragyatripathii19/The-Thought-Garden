# Copy this file to .env and fill it in. .env is git-ignored; never commit it.

# Postgres connection string.
# Local:  postgres://USER:PASSWORD@localhost:5432/thought_garden_dev
# Neon:   copy the connection string from the Neon dashboard (it ends in ?sslmode=require)
DATABASE_URL=postgres://thought_garden:change-me@localhost:5432/thought_garden_dev

# Used only by `npm run test:backend`. Its tables are wiped on every run.
TEST_DATABASE_URL=postgres://thought_garden:change-me@localhost:5432/thought_garden_test

# Comma-separated emails that can open the admin dashboard.
ADMIN_EMAILS=

# Optional: Smart organising via any OpenAI-compatible API (e.g. a free Groq key).
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant

# PORT=3001
